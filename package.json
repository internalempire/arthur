{
  "name": "arthur",
  "version": "1.0.0",
  "description": "Real-time web simulator of mechanical heart-lung interaction. Teaching only.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/internalempire/arthur.git"
  },
  "keywords": [
    "physiology",
    "simulation",
    "mechanical-ventilation",
    "haemodynamics",
    "teaching"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "snapshots": "node tests/generate-snapshots.mjs",
    "serve": "python3 -m http.server 8422",
    "serve:dev": "node tools/serve.mjs",
    "manual:build": "node manual/tools/build.mjs",
    "manual:lint": "node manual/tools/examples.mjs --check && node manual/tools/lint.mjs",
    "manual:examples": "node manual/tools/examples.mjs --write",
    "manual:figures": "node manual/figure/generate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "private": false
}
